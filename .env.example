# Copy this file to .env and edit. Every setting is optional.

# Rename the app (shown in the interface, emails and link previews).
# APP_NAME=Waymark
# APP_TAGLINE=Stories with a sense of place.

# Port to listen on. With Docker Compose, this is the port on your computer (inside the container it is always 5180).
PORT=5180

# Network interface. 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your network too.
HOST=127.0.0.1

# Public address of your site, used in password reset emails. Set this when you host it.
# APP_URL=https://stories.example.com

# Where the database and uploaded images are stored. Back this folder up.
# DATA_DIR=./data

# Set to 1 when the site is served over HTTPS (recommended for anything public).
# COOKIE_SECURE=1

# Set to 0 to stop new people from creating accounts (after you've made yours).
# ALLOW_SIGNUP=0

# --- Email for password resets -------------------------------------------------
# Without SMTP_HOST, reset links are printed in the server's terminal instead.
# Works with any SMTP provider (Postmark, Resend, SendGrid, Mailgun, Gmail app password, ...).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# SMTP_FROM="Waymark <no-reply@example.com>"
# tls (port 465) | starttls (default) | none (only for local test inboxes like Mailpit)
# SMTP_SECURE=starttls
